# Optional: only needed to transcribe your own footage with ElevenLabs Scribe.
# Get a key with speech_to_text access at https://elevenlabs.io/app/settings/api-keys
# Copy this file to .env locally. Never commit your key.
ELEVENLABS_API_KEY=

# Optional integrations used by the older examples.
CLICKUP_API_KEY=
OPENAI_API_KEY=
# Optional generated footage; configure only when using this provider.
KIE_API_KEY=
